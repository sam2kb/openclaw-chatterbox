# Compose configuration example. Copy to a private file and do not commit it.
# Use: docker compose --env-file config/clawvoice.env -f deploy/compose.yaml ...
CLAWVOICE_RELEASE=0.1.0
CLAWVOICE_PORT=8765
CLAWVOICE_PUBLIC_BASE_URL=http://127.0.0.1:8765
CLAWVOICE_ALLOWED_ORIGINS=http://127.0.0.1:8765
# Relative to deploy/compose.yaml; holds chatterbox-turbo/.
CLAWVOICE_MODELS_DIR=../models
CLAWVOICE_DEVICE=cuda
CLAWVOICE_LOG_LEVEL=info
CLAWVOICE_JOB_TIMEOUT_SECONDS=300
CLAWVOICE_CLEANUP_INTERVAL_SECONDS=3600
# Optional Hugging Face token for the explicit provision profile only.
# Prefer runtime secret injection; do not commit it.
HF_TOKEN=
