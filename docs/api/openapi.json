              },
              {
                "type": "null"
              }
            ],
            "title": "End Ms"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "start_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
