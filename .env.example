# Copy to a private, gitignored location. Never commit real values.
CLAWVOICE_URL=http://127.0.0.1:8765
# The server writes its service token to this path with mode 0600.
CLAWVOICE_TOKEN_FILE=./var/secrets/service-token
CLAWVOICE_DATA_DIR=./var
CLAWVOICE_BIND_HOST=127.0.0.1
CLAWVOICE_BIND_PORT=8765
CLAWVOICE_BACKEND=turbo
CLAWVOICE_DEVICE=cuda
CLAWVOICE_MODEL_DIR=./models/chatterbox-turbo
# Comma-separated exact origins only; no wildcard.
CLAWVOICE_ALLOWED_ORIGINS=http://127.0.0.1:8765
